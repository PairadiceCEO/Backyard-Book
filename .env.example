# Names of every environment variable Pairadice Casino uses.
# Enter the real values in Vercel: Project > Settings > Environment Variables.
# Never put real values in this file.

# Public Firebase web config (Firebase console > Project settings > General > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin service account (Project settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# One-time admin creation on /setup
SETUP_SECRET=

# Sent by Vercel on cron calls (used from Phase 7)
CRON_SECRET=
