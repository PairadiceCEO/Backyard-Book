rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.admin == true; }
    function owns(data) { return signedIn() && data.uid == request.auth.uid; }

    // Leaderboard needs every player's wallet and stats.
    match /users/{uid}       { allow read: if signedIn();                      allow write: if false; }
    match /bets/{betId}      { allow read: if isAdmin() || owns(resource.data); allow write: if false; }
    match /ledger/{entryId}  { allow read: if isAdmin() || owns(resource.data); allow write: if false; }
    match /customGames/{id}  { allow read: if signedIn();                      allow write: if false; }
    match /challenges/{id}   { allow read: if signedIn();                      allow write: if false; }

    // Battles: the admin and the Battle's own players. My Battles are read with a query on
    // participantUids array-contains my uid, which these rules allow.
    match /battles/{id} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.participantUids);
      allow write: if false;
    }

    // Casino tables: anyone signed in can watch; only the server writes.
    match /casinoTables/{game} {
      allow read: if signedIn();
      allow write: if false;
      // private/shoe (the shoe and the hole card) and presence/{uid}: no client may read or write, ever.
      match /{sub=**} { allow read, write: if false; }
    }

    // Casino chat (0.17.0): one room per game; anyone signed in reads; only the server writes, ever.
    // chatRate/{uid} (the server's rate counter) is covered by the server-only rule below.
    match /casinoChat/{game}/messages/{messageId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // usernames, cache, meta, chatRate and anything not listed: server only.
    match /{document=**}     { allow read, write: if false; }
  }
}
